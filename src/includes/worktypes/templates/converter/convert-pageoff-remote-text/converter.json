{
  "type": "converter",
  "name": "convert-pageoff-remote-text",
  "label": "Convert Pageoff Remote Text",
  "description": "Pageoff-only demo converter: previews locally, converts through a local remote PHP endpoint, then saves the response as a generated work.",
  "accepts": ["text/plain", "text/*", "application/json"],
  "outputs": ["text/html", "text/plain"],
  "engine": "remote-node",
  "url": "https://pageoff.de/?edit=true#/converter/convert-pageoff-remote-text",
  "remote": {
    "nodeId": "pageoff",
    "publicUrl": "https://pageoff.de/?edit=true#/converter/convert-pageoff-remote-text",
    "endpoint": "https://pageoff.de/worktypes/templates/converter/convert-pageoff-remote-text/converter.php"
  },
  "defaults": {
    "format": "html",
    "quality": "default",
    "saveMode": "new-hidden-work",
    "hiddenByDefault": true
  },
  "ui": {
    "format": {
      "type": "select",
      "label": "Output format",
      "options": ["html", "txt"]
    },
    "quality": {
      "type": "select",
      "label": "Quality",
      "options": ["preview", "default"]
    },
    "saveMode": {
      "type": "select",
      "label": "Save mode",
      "options": ["new-hidden-work", "temporary-preview-only"]
    }
  }
}
