<article class="poff-image-converter__panel">
  <header class="poff-image-converter__meta">
    <h2 class="poff-image-converter__title">{{converter.label}}</h2>
    <p class="poff-image-converter__summary">{{converter.description}}</p>
  </header>
  <figure class="poff-image-converter__preview">
    <img class="poff-image-converter__image" src="{{source.srcUrl}}" alt="{{source.name}}">
    <figcaption class="poff-image-converter__caption">
      <span>{{source.name}}</span>
      <span>{{converter.format}}</span>
    </figcaption>
  </figure>
</article>
