{
  "excludeFolders": [
    "node_modules",
    "dist",
    "output",
    "pages",
    "vendor",
    ".git",
    ".history",
    ".mlms",
    ".playwright-cli",
    "memory-bank"
  ],
  "excludeFiles": [
    "README.md",
    "output-prompt.txt",
    "package-lock.json",
    ".DS_Store"
  ],
  "patterns": [
    {
      "src": "./package.json"
    },
    {
      "src": "./build/BuildConfig.shared.json"
    },
    {
      "src": "./build/**/*.php"
    },
    {
      "src": "./scripts/**/*.js"
    },
    {
      "src": "./src/includes/**/*.php"
    },
    {
      "src": "./src/includes/worktypes/templates/**/*.hbs"
    },
    {
      "src": "./src/includes/worktypes/templates/**/*.css"
    },
    {
      "src": "./src/includes/worktypes/templates/**/*.js"
    },
    {
      "src": "./src/includes/worktypes/templates/**/*.json"
    },
    {
      "src": "./src/assets/js/**/*.js"
    },
    {
      "src": "./src/assets/scss/**/*.scss"
    },
    {
      "src": "./src/mcp/**/*.php"
    }
  ],
  "textEdit": true,
  "ignoreGitignore": false
}
